# Generates a C++ source holding the text of the given data files, so that
# the default LDPC matrices and the q-ary table need no data directory.
# icov_embed_data(<output.cpp> <data root> <relative dir>...)
function(icov_embed_data output root)
  set(entries "")
  set(depends "")
  foreach(dir ${ARGN})
    file(GLOB_RECURSE files RELATIVE "${root}" "${root}/${dir}/*")
    list(SORT files)
    foreach(rel ${files})
      file(READ "${root}/${rel}" content)
      string(APPEND entries "      {\"${rel}\", R\"ICOV(${content})ICOV\"},\n")
      list(APPEND depends "${root}/${rel}")
    endforeach()
  endforeach()

  set(source "// Generated by cmake/EmbedData.cmake, do not edit
#include <map>
#include <string>

namespace icov {
namespace data {

const std::map<std::string, std::string> &builtin_files() {
  static const std::map<std::string, std::string> files = {
${entries}  };
  return files;
}

} // namespace data
} // namespace icov
")
  file(CONFIGURE OUTPUT "${output}" CONTENT "${source}" @ONLY)
  # reconfigure when a data file changes
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${depends})
endfunction()
